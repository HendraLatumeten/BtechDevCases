# PostgreSQL (used by Docker Compose)
POSTGRES_DB=trailwallet
POSTGRES_USER=trailwallet
POSTGRES_PASSWORD=trailwallet_pass
POSTGRES_PORT=5432

# Backend API
BACKEND_PORT=3000
# For local dev without Docker, omit DATABASE_URL or use pglite://./data/pgdata
DATABASE_URL=postgres://trailwallet:trailwallet_pass@localhost:5432/trailwallet
JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_EXPIRES_IN=24h
INACTIVITY_TIMEOUT_MINUTES=15
INITIAL_WALLET_BALANCE=1000.00
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Frontend
FRONTEND_PORT=8080

